{
  "name": "jp-vocab",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/miniprogram",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build --configLoader native",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "build:miniprogram": "npm run build:mp-weixin --workspace=apps/miniprogram",
    "check:cloudflare": "tsc -p tsconfig.cloudflare.json --noEmit",
    "upload:r2": "node scripts/upload-r2-assets.mjs",
    "test": "vitest run --configLoader native",
    "test:e2e": "playwright test",
    "preview": "vite preview --configLoader native --host 127.0.0.1 --port 5173",
    "start": "node scripts/start-local.mjs",
    "build:windows": "node scripts/prepare-electron.cjs && npm run build && electron-builder --win --x64",
    "desktop": "electron apps/windows"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "lucide-vue-next": "^0.468.0",
    "papaparse": "^5.5.0",
    "pinia": "^3.0.0",
    "ts-fsrs": "^5.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.0",
    "wrangler": "4.132.0"
  }
}
