# ==============================================================================
# KotoBud (Kotoba) Environment Variables Configuration Template
# Copy this file to .env or set environment variables in your deployment environment.
# DO NOT commit real secrets, tokens or credentials to version control.
# ==============================================================================

# --- Cloudflare & Deployment ---
# Cloudflare Account ID (optional for local wrangler if logged in via OAuth)
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare API Token (optional for headless CI/CD deployments)
CLOUDFLARE_API_TOKEN=

# --- Authentication (CloudBase) ---
# CloudBase environment ID for OTP email verification code service
CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_ENV_ID=

# --- Frontend & Client Runtime ---
# Custom API base URL (empty for same-origin web, defaults to https://kotobud.com in desktop)
VITE_API_BASE_URL=
# Flag indicating Windows 0.6.0 releases are ready on R2 for client downloads ("true" | "false")
VITE_WINDOWS_DOWNLOADS_READY=true
# Data dictionary / assets cache versioning (e.g. "v1")
KOTOBA_DATA_VERSION=v1

# --- Google Cloud TTS (Offline Audio Generation Tooling) ---
# Google Cloud Project ID for Text-to-Speech batch synthesis
GOOGLE_CLOUD_PROJECT=
# Path to local Application Default Credentials (ADC) JSON file
GOOGLE_APPLICATION_CREDENTIALS=
