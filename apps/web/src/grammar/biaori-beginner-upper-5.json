  "points": [
    {
      "id": "l5-clock-time",
      "title": "现在时间：～時～分です",
      "meaning": "说明当前时刻，或询问具体是几点几分。",
      "connection": "今（は）～時～分です。／今（は）何時ですか。",
      "explanation": "报时通常用「～時～分です」；双方已经明确在谈现在时，可以省略「今」。询问几点用「何時ですか」，询问几分可用「何分ですか」。三十分也可说「半」，具体时刻前可加「午前」或「午後」说明时段。",
      "tip": "「半」表示三十分，只能接在时刻后，如「九時半」；不要把「何時」读成「なんじ」以外的形式。",
      "examples": [
        {
          "ja": "今は午後六時十五分です。",
          "reading": "いまはごごろくじじゅうごふんです。",
          "zh": "现在是下午六点十五分。",
          "parts": [
            {
              "text": "今",
              "label": "当前时间"
            },
            {
              "text": "は",
              "label": "提示谈论主题"
            },
            {
              "text": "午後",
              "label": "下午时段"
            },
            {
              "text": "六時",
              "label": "小时"
            },
            {
              "text": "十五分",
              "label": "分钟"
            },
            {
              "text": "です。",
              "label": "礼貌说明"
            }
          ]
        },
        {
          "ja": "今は何時ですか。",
          "reading": "いまはなんじですか。",
          "zh": "现在几点？",
          "parts": [
            {
              "text": "今",
              "label": "当前时间"
            },
            {
              "text": "は",
              "label": "提示谈论主题"
            },
            {
              "text": "何時",
              "label": "询问具体时刻"
            },
            {
              "text": "ですか。",
              "label": "礼貌提问"
            }
          ]
        }
      ]
    },
    {
      "id": "l5-masu-tense",
      "title": "动词ます／ません／ました／ませんでした",
      "meaning": "用礼貌体肯定或否定现在、习惯、将来以及过去的动作。",
      "connection": "动词ます／ません（非过去肯定／否定）；动词ました／ませんでした（过去肯定／否定）。",
      "explanation": "礼貌体动词的非过去肯定用「ます」，否定用「ません」；它们可说习惯或将来的动作。叙述过去时，肯定改为「ました」，否定改为「ませんでした」。过去否定要变更句末形式，不能只把中文的“没”加在时间词前。",
      "tip": "「昨日」等过去时间词出现时，也要把动词变成「ました／ませんでした」；不能因为中文只说“昨天”就保留「ます」。",
      "examples": [
        {
          "ja": "木村さんは働きます。今日は働きません。",
          "reading": "きむらさんははたらきます。きょうははたらきません。",
          "zh": "木村先生上班。今天不上班。",
          "parts": [
            {
              "text": "木村さん",
              "label": "动作的人"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "働きます。",
              "label": "非过去肯定"
            },
            {
              "text": "今日",
              "label": "当前日期"
            },
            {
              "text": "は",
              "label": "提示对比项"
            },
            {
              "text": "働きません。",
              "label": "非过去否定"
            }
          ]
        },
        {
          "ja": "昨日、山田さんは休みました。先週は休みませんでした。",
          "reading": "きのう、やまださんはやすみました。せんしゅうはやすみませんでした。",
          "zh": "昨天山田先生休息了。上周没有休息。",
          "parts": [
            {
              "text": "昨日、",
              "label": "过去时间"
            },
            {
              "text": "山田さん",
              "label": "动作的人"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "休みました。",
              "label": "过去肯定"
            },
            {
              "text": "先週",
              "label": "过去时间"
            },
            {
              "text": "は",
              "label": "提示谈论主题"
            },
            {
              "text": "休みませんでした。",
              "label": "过去否定"
            }
          ]
        }
      ]
    },
    {
      "id": "l5-time-ni",
      "title": "具体时间 + に + 动词",
      "meaning": "标明动作发生的具体时刻或日期。",
      "connection": "具体时间词 + に + 动词；今／昨日／今日／明日／毎日等相对时间词后通常不加「に」。",
      "explanation": "表示动作发生的具体钟点、日期或年份时，时间词后接「に」，如「九時に」「三月十日に」。表示现在、昨天、今天、明天、每天等相对时间的词后通常不接「に」；星期几后可以加，也可以不加。",
      "tip": "先判断时间词是不是具体数字时刻：具体时刻用「に」，「明日」「今日」「毎日」后不加「に」。",
      "examples": [
        {
          "ja": "授業は九時に始まります。",
          "reading": "じゅぎょうはくじにはじまります。",
          "zh": "课程九点开始。",
          "parts": [
            {
              "text": "授業",
              "label": "动作或事件"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "九時",
              "label": "具体时刻"
            },
            {
              "text": "に",
              "label": "标记动作时间"
            },
            {
              "text": "始まります。",
              "label": "发生的动作"
            }
          ]
        },
        {
          "ja": "明日、わたしは休みます。",
          "reading": "あした、わたしはやすみます。",
          "zh": "明天我休息。",
          "parts": [
            {
              "text": "明日、",
              "label": "相对时间词"
            },
            {
              "text": "わたし",
              "label": "动作的人"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "休みます。",
              "label": "非过去动作"
            }
          ]
        }
      ]
    },
    {
      "id": "l5-time-range",
      "title": "时间から时间まで：起点与终点",
      "meaning": "指出动作或状态开始、结束的时间，也可只说明其中一端。",
      "connection": "时间A から 时间B まで + 动词；「から」或「まで」也可以单独使用。",
      "explanation": "「から」标记时间起点，相当于“从”；「まで」标记终点，相当于“到”。两者可以一起框出一个时间范围，也可以只说起点或终点。",
      "tip": "「から」表示起点，「まで」表示终点；说完整范围时按「から」在前、「まで」在后的顺序。",
      "examples": [
        {
          "ja": "水曜日から金曜日まで働きます。",
          "reading": "すいようびからきんようびまではたらきます。",
          "zh": "从星期三到星期五上班。",
          "parts": [
            {
              "text": "水曜日",
              "label": "时间起点"
            },
            {
              "text": "から",
              "label": "标记起始时间"
            },
            {
              "text": "金曜日",
              "label": "时间终点"
            },
            {
              "text": "まで",
              "label": "标记结束时间"
            },
            {
              "text": "働きます。",
              "label": "持续期间的动作"
            }
          ]
        },
        {
          "ja": "わたしは午後六時まで働きます。",
          "reading": "わたしはごごろくじまではたらきます。",
          "zh": "我工作到下午六点。",
          "parts": [
            {
              "text": "わたし",
              "label": "动作的人"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "午後六時",
              "label": "时间终点"
            },
            {
              "text": "まで",
              "label": "标记结束时间"
            },
            {
              "text": "働きます。",
              "label": "发生的动作"
            }
          ]
        }
      ]
    },
    {
      "id": "l5-itsu-question",
      "title": "いつ + 动词ますか：询问时间",
      "meaning": "询问某个动作或事件在什么时候发生。",
      "connection": "いつ + 动词ますか；问具体时刻用「何時に」、星期几用「何曜日に」、几号用「何日に」。",
      "explanation": "用「いつ」询问动作或事件发生的时间，句末接「か」构成礼貌疑问。若要问具体钟点、星期几或几号，可分别用「何時に」「何曜日に」「何日に」；询问持续时间的起点或终点时，可说「いつから」「何曜日まで」。",
      "tip": "「いつ」直接询问大致时间；换成具体的「何時／何曜日／何日」时，按需要在后面加「に」，问句仍要以「か」收尾。",
      "examples": [
        {
          "ja": "講演はいつ始まりますか。",
          "reading": "こうえんはいつはじまりますか。",
          "zh": "演讲什么时候开始？",
