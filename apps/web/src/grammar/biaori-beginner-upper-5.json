              "label": "询问的事件"
            },
            {
              "text": "は",
              "label": "提示谈论主题"
            },
            {
              "text": "何時",
              "label": "询问具体时刻"
            },
            {
              "text": "に",
              "label": "标记动作时间"
            },
            {
              "text": "始まります",
              "label": "询问发生的动作"
            },
            {
              "text": "か。",
