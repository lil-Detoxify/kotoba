    {
      "id": "l7-object-o",
      "title": "名词を + 动词：动作对象",
      "meaning": "指出动作直接作用于什么人或事物。",
      "connection": "动作对象 を + 动词；作助词时「を」读「お」。",
      "explanation": "助词「を」放在动作对象之后、动词之前，标记动作直接作用的对象。作为助词时，「を」读作「お」。",
      "tip": "「を」在这里读「お」，写法仍是「を」；动作对象放在动词前，不要把「を」误当成地点助词。",
      "examples": [
        {
          "ja": "毎朝、新聞を読みます。",
          "reading": "まいあさ、しんぶんをよみます。",
          "zh": "每天早晨看报纸。",
          "parts": [
            {
              "text": "毎朝、",
              "label": "动作时间"
            },
            {
              "text": "新聞",
              "label": "动作对象"
            },
            {
              "text": "を",
              "label": "标记动作对象"
            },
            {
              "text": "読みます。",
              "label": "动作"
            }
          ]
        },
        {
          "ja": "父は音楽を聞きます。",
          "reading": "ちちはおんがくをききます。",
          "zh": "爸爸听音乐。",
          "parts": [
            {
