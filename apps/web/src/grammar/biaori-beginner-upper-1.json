  "points": [
    {
      "id": "l1-identity",
      "title": "名词は名词です",
      "meaning": "用于礼貌地说明人物身份、国籍等。",
      "connection": "名词A は 名词B です。",
      "explanation": "先说要介绍的人或事物，再用「は」把它作为谈话主题；后面的名词说明身份或类别，「です」让判断语气礼貌。",
      "tip": "「は」作主题标记时读「わ」，但写法仍是「は」；身份名词后别漏掉「です」。",
      "examples": [
        {
          "ja": "わたしはイタリア人です。",
          "reading": "わたしはいたりあじんです。",
          "zh": "我是意大利人。",
          "parts": [
            {
              "text": "わたし",
              "label": "人物"
            },
            {
              "text": "は",
              "label": "主题"
            },
            {
              "text": "イタリア人",
              "label": "身份"
            },
            {
              "text": "です。",
              "label": "礼貌判断"
            }
          ]
        },
        {
          "ja": "中村さんは会社員です。",
          "reading": "なかむらさんはかいしゃいんです。",
          "zh": "中村先生是公司职员。",
          "parts": [
            {
              "text": "中村さん",
              "label": "人物"
            },
            {
              "text": "は",
              "label": "主题"
            },
            {
              "text": "会社員",
              "label": "身份"
            },
            {
              "text": "です。",
              "label": "礼貌判断"
            }
          ]
        }
      ]
    },
    {
      "id": "l1-negative",
      "title": "名词は名词ではありません",
      "meaning": "用于礼貌地说明某人或某物不属于某种身份、类别。",
      "connection": "名词A は 名词B ではありません。／（口语）じゃありません。",
      "explanation": "在主题后说出要否定的身份或类别，再接「ではありません」表达“不是……”。口语中常把「では」缩成「じゃ」，意思不变。",
      "tip": "「ではありません」较郑重，「じゃありません」较口语；两种形式都接在名词后，表示否定。",
      "examples": [
        {
          "ja": "小林さんはフランス人ではありません。",
          "reading": "こばやしさんはふらんすじんではありません。",
          "zh": "小林先生不是法国人。",
          "parts": [
            {
              "text": "小林さん",
              "label": "人物"
            },
            {
              "text": "は",
              "label": "主题"
            },
            {
              "text": "フランス人",
              "label": "被否定的身份"
            },
            {
              "text": "ではありません。",
              "label": "礼貌否定"
            }
          ]
        },
        {
          "ja": "わたしは先生じゃありません。",
          "reading": "わたしはせんせいじゃありません。",
          "zh": "我不是老师。",
          "parts": [
            {
              "text": "わたし",
              "label": "人物"
            },
            {
              "text": "は",
              "label": "主题"
            },
            {
              "text": "先生",
              "label": "被否定的身份"
            },
            {
              "text": "じゃありません。",
              "label": "口语否定"
            }
          ]
        }
      ]
    },
    {
      "id": "l1-question",
      "title": "ですか与应答",
      "meaning": "用句末「か」确认身份，并作肯定或否定回答。",
      "connection": "名词A は 名词B ですか。— はい、名词B です。／いいえ、名词B ではありません。",
      "explanation": "在礼貌判断句末加「か」就能提问。肯定时可回答「はい、そうです」或复述身份；否定时用「いいえ」并说明真实情况。",
      "tip": "问句末尾用「か」；回答接「はい」或「いいえ」后说结论，不把「か」带进回答。",
      "examples": [
        {
          "ja": "鈴木さんは日本人ですか。はい、日本人です。",
          "reading": "すずきさんはにほんじんですか。はい、にほんじんです。",
          "zh": "铃木先生是日本人吗？是的，是日本人。",
          "parts": [
