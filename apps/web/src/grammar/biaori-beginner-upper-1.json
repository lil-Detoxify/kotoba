              "label": "待确认身份"
            },
            {
              "text": "ですか。",
              "label": "疑问"
            },
            {
              "text": "はい、",
              "label": "肯定应答"
            },
            {
              "text": "日本人",
              "label": "确认身份"
            },
            {
              "text": "です。",
              "label": "礼貌判断"
            }
          ]
        },
        {
          "ja": "高橋さんはアメリカ人ですか。いいえ、イギリス人です。",
          "reading": "たかはしさんはあめりかじんですか。いいえ、いぎりすじんです。",
          "zh": "高桥先生是美国人吗？不，是英国人。",
          "parts": [
            {
              "text": "高橋さん",
              "label": "提问对象"
            },
            {
              "text": "は",
              "label": "主题"
            },
            {
              "text": "アメリカ人",
              "label": "待确认身份"
            },
            {
              "text": "ですか。",
              "label": "疑问"
            },
            {
              "text": "いいえ、",
              "label": "否定应答"
            },
            {
              "text": "イギリス人",
              "label": "正确身份"
            },
            {
              "text": "です。",
              "label": "礼貌判断"
            }
          ]
        }
      ]
