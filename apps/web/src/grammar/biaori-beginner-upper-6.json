  "points": [
    {
      "id": "l6-destination-e",
      "title": "场所へ + 移动动词",
      "meaning": "表示移动的方向或目的地。",
      "connection": "场所 へ + 行きます／来ます／帰ります；助词「へ」在这里读「え」。",
      "explanation": "与「行きます」「来ます」「帰ります」等移动动词搭配时，用「へ」标明移动的目的地或方向。虽然写作「へ」，作助词时读「え」。",
      "tip": "这里的「へ」读「え」，表示去往的方向；不要按字母读作「へ」。",
      "examples": [
        {
          "ja": "来月、妹は大阪へ行きます。",
          "reading": "らいげつ、いもうとはおおさかへいきます。",
          "zh": "下个月，妹妹要去大阪。",
          "parts": [
            {
              "text": "来月、",
              "label": "时间"
            },
            {
              "text": "妹",
              "label": "移动的人"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "大阪",
              "label": "移动目的地"
            },
            {
              "text": "へ",
              "label": "标记移动方向"
            },
            {
              "text": "行きます。",
              "label": "表示前往"
            }
          ]
        },
        {
          "ja": "中村さんは京都へ帰りました。",
          "reading": "なかむらさんはきょうとへかえりました。",
          "zh": "中村先生回京都了。",
          "parts": [
