  "points": [
    {
      "id": "l21-ta-form",
      "title": "动词的た形",
      "meaning": "沿用て形的变化，把「て／で」换成「た／だ」。",
      "connection": "書いて → 書いた　読んで → 読んだ　食べて → 食べた",
      "explanation": "五段动词可按词尾记：書く→書いた、急ぐ→急いだ；飛ぶ・読む・死ぬ分别变成飛んだ・読んだ・死んだ；待つ・売る・買う分别变成待った・売った・買った；話す→話した。一段动词去掉「る」加「た」，如見る→見た。特殊动词：する→した、来る→来た（きた）。",
      "tip": "「行く」的た形是「行った」。た形也能接别的句型，比如「たほうがいい」说的是建议，不一定是过去发生的事。 例句用た形直接收尾，是简体说法；第22课会集中对比简体和敬体。",
      "examples": [
        {
          "ja": "昨日、切符を買った。",
          "reading": "きのう、きっぷをかった。",
          "zh": "昨天买了车票。",
          "parts": [
            {
              "text": "昨日、",
              "label": "过去的时间"
            },
            {
              "text": "切符を",
              "label": "买的东西"
            },
            {
              "text": "買った。",
              "label": "買う的た形"
            }
          ]
        },
        {
          "ja": "今朝、手紙を書いた。",
          "reading": "けさ、てがみをかいた。",
          "zh": "今天早上写了信。",
          "parts": [
            {
              "text": "今朝、",
              "label": "时间"
            },
            {
              "text": "手紙を",
              "label": "写的东西"
            },
            {
              "text": "書いた。",
              "label": "書く的た形"
            }
          ]
        }
      ]
    },
    {
      "id": "l21-experience",
      "title": "～たことがあります",
      "meaning": "说曾经做过某件事，重点是有没有这段经历。",
      "connection": "动词た形 ＋ ことがあります／ことがありません",
      "explanation": "肯定说「～たことがあります」，否定说「～たことがありません」。「一度も」和否定搭配，表示一次也没有。问「～たことがありますか」时，可以简答「はい、あります」或「いいえ、ありません」。",
      "tip": "叙述昨天去了哪里，通常直接说「昨日～へ行きました」。要说去过某个地方，才用「～へ行ったことがあります」。",
      "examples": [
        {
          "ja": "京都で着物を着たことがあります。",
          "reading": "きょうとできものをきたことがあります。",
          "zh": "我曾在京都穿过和服。",
          "parts": [
            {
              "text": "京都で",
              "label": "经历发生的地点"
            },
            {
              "text": "着物を",
              "label": "穿的东西"
            },
            {
              "text": "着た",
              "label": "着る的た形"
            },
            {
              "text": "ことがあります。",
              "label": "有过这段经历"
            }
          ]
        },
        {
          "ja": "一度も船に乗ったことがありません。",
          "reading": "いちどもふねにのったことがありません。",
          "zh": "我一次船也没坐过。",
          "parts": [
            {
              "text": "一度も",
              "label": "一次也，呼应否定"
            },
            {
              "text": "船に",
              "label": "乘坐的交通工具"
            },
            {
              "text": "乗った",
              "label": "乗る的た形"
            },
            {
              "text": "ことがありません。",
              "label": "没有这段经历"
            }
          ]
        }
      ]
    },
    {
      "id": "l21-after",
      "title": "～た後で／名词の後で",
      "meaning": "先做完前一件事，再做后一件事。",
      "connection": "动词た形 ＋ 後で　名词 ＋ の後で",
      "explanation": "如果前面是动作，用た形接「後で」；如果前面是表示时间或事件的名词，就用「の後で」。后半句说接着要做什么或做了什么。",
      "tip": "把「吃完饭后」和「吃饭前」对照记：食べた後で／食べる前に。前者用た形，后者用基本形。",
      "examples": [
        {
          "ja": "宿題をした後で、音楽を聞きます。",
          "reading": "しゅくだいをしたあとで、おんがくをききます。",
          "zh": "做完作业后，我会听音乐。",
          "parts": [
            {
              "text": "宿題をした",
              "label": "先做作业"
            },
            {
              "text": "後で、",
              "label": "做完之后"
            },
            {
              "text": "音楽を聞きます。",
              "label": "再听音乐"
            }
          ]
        },
        {
          "ja": "会議の後で、駅へ行きます。",
          "reading": "かいぎのあとで、えきへいきます。",
          "zh": "开完会后，我去车站。",
          "parts": [
            {
              "text": "会議",
              "label": "先发生的事"
            },
            {
              "text": "の後で、",
              "label": "名词接「の後で」"
            },
            {
              "text": "駅へ行きます。",
              "label": "之后的行动"
            }
          ]
        }
      ]
    },
    {
      "id": "l21-advice",
      "title": "～たほうがいいです／～ないほうがいいです",
      "meaning": "给对方建议：最好做，或者最好别做。",
      "connection": "动词た形／动词ない形 ＋ ほうがいいです",
      "explanation": "建议做某事，用「～たほうがいいです」。劝对方避免某事，用「～ないほうがいいです」。这个句型表达说话人的判断，语气比单纯陈述更直接。",
      "tip": "「最好不要去」说「行かないほうがいいです」，这里用ない形。先确认建议是做还是不做，再选接续。",
      "examples": [
        {
          "ja": "雨ですから、傘を持って行ったほうがいいです。",
          "reading": "あめですから、かさをもっていったほうがいいです。",
          "zh": "因为下雨，最好带伞去。",
          "parts": [
            {
              "text": "雨ですから、",
              "label": "给建议的理由"
            },
            {
              "text": "傘を持って行った",
              "label": "建议采取的行动"
            },
            {
              "text": "ほうがいいです。",
              "label": "最好这样做"
            }
          ]
        },
        {
          "ja": "夜遅くにコーヒーを飲まないほうがいいです。",
          "reading": "よるおそくにこーひーをのまないほうがいいです。",
          "zh": "深夜最好别喝咖啡。",
          "parts": [
            {
              "text": "夜遅くに",
              "label": "时间"
            },
            {
              "text": "コーヒーを飲まない",
              "label": "建议避免的行为"
            },
            {
              "text": "ほうがいいです。",
              "label": "这样比较好"
            }
          ]
        }
      ]
    },
    {
      "id": "l21-offer",
      "title": "～ましょうか",
      "meaning": "可以提议一起做，也可以问对方要不要自己帮忙。",
      "connection": "动词ます形去掉「ます」＋ ましょうか",
      "explanation": "提议一起做时，可以回答「いいですね」或「はい、そうしましょう」。对方主动提出帮忙时，接受可以说「はい、お願いします」，婉拒可以说「いいえ、大丈夫です」。",
      "tip": "先判断谁来做。「一緒に帰りましょうか」是一起走；对提着重物的人说「荷物を持ちましょうか」是问要不要我来提。",
      "examples": [
        {
          "ja": "一緒に昼ご飯を食べましょうか。",
          "reading": "いっしょにひるごはんをたべましょうか。",
          "zh": "要不要一起吃午饭？",
          "parts": [
            {
              "text": "一緒に",
              "label": "邀请一起做"
            },
            {
              "text": "昼ご飯を",
              "label": "午饭"
            },
            {
              "text": "食べましょうか。",
              "label": "征求对方的意见"
            }
          ]
        },
        {
          "ja": "その荷物を持ちましょうか。",
          "reading": "そのにもつをもちましょうか。",
          "zh": "我帮你拿那件行李吧？",
          "parts": [
            {
              "text": "その荷物を",
              "label": "对方的行李"
            },
            {
              "text": "持ちましょうか。",
              "label": "主动提出帮忙"
            }
          ]
        }
      ]
    }
  ],
