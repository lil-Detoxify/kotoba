    {
      "id": "l8-sentence-final-yo",
      "title": "句末よ：提醒或告知",
      "meaning": "提醒听话人注意其可能还不知道的信息。",
      "connection": "句子 + よ。",
      "explanation": "在句末加「よ」，可告知或提醒听话人注意新信息；根据语境，语气可以是温和提醒，也可以带有轻微警告。它强调说话人正在提供信息。",
      "tip": "「よ」用于把信息告诉对方；如果重点是征求对方认同，才考虑用「ね」，两者语气不同。",
      "examples": [
        {
          "ja": "今日は休みですよ。",
          "reading": "きょうはやすみですよ。",
          "zh": "今天休息哦。",
          "parts": [
            {
              "text": "今日",
              "label": "告知的时间"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "休みです",
              "label": "提供的信息"
            },
            {
              "text": "よ。",
              "label": "提醒对方留意"
            }
          ]
        },
        {
          "ja": "あそこに新しい店がありますよ。",
          "reading": "あそこにあたらしいみせがありますよ。",
          "zh": "那边有一家新店哦。",
          "parts": [
            {
              "text": "あそこ",
              "label": "地点"
            },
            {
              "text": "に",
              "label": "标记存在地点"
            },
            {
              "text": "新しい店",
              "label": "新信息"
            },
            {
              "text": "が",
              "label": "提示新出现的对象"
            },
            {
              "text": "あります",
              "label": "表示存在"
            },
            {
              "text": "よ。",
              "label": "提醒对方留意"
            }
          ]
        }
      ]
    },
    {
      "id": "l8-mou",
      "title": "もう：已经完成",
      "meaning": "说明某动作或事项已经完成。",
      "connection": "もう + 动词过去肯定形（ました）。",
      "explanation": "副词「もう」放在动词前，表示事情已经完成，常与过去肯定形式「ました」搭配。回答“已经做了吗”时，肯定句可说「はい、もう……ました」。",
      "tip": "表达“已经做完”时，既要用「もう」，也要把动词变为过去肯定「ました」；不要只加「もう」而保留「ます」。",
      "examples": [
        {
          "ja": "もうメールを送りました。",
          "reading": "もうめーるをおくりました。",
          "zh": "已经发了电子邮件。",
          "parts": [
            {
              "text": "もう",
              "label": "表示已经完成"
            },
            {
              "text": "メール",
              "label": "发送的内容"
            },
            {
              "text": "を",
              "label": "标记动作对象"
            },
            {
              "text": "送りました。",
              "label": "表示过去完成的动作"
            }
          ]
        },
        {
          "ja": "兄はもう帰りました。",
          "reading": "あにはもうかえりました。",
          "zh": "哥哥已经回去了。",
