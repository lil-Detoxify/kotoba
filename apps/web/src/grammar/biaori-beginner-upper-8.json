            {
              "text": "わたし",
              "label": "动作的人"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "ペン",
              "label": "动作工具"
            },
            {
              "text": "で",
              "label": "标记使用的工具"
            },
            {
              "text": "名前",
              "label": "书写内容"
            },
            {
              "text": "を",
              "label": "标记动作对象"
            },
            {
              "text": "書きます。",
              "label": "动作"
            }
          ]
        },
        {
          "ja": "この箱は紙で作りました。",
          "reading": "このはこはかみでつくりました。",
          "zh": "这个盒子是用纸做的。",
          "parts": [
