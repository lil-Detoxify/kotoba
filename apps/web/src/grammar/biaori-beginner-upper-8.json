    {
      "id": "l8-agemasu",
      "title": "人は人に物をあげます：给予",
      "meaning": "说明谁把什么东西给了谁。",
      "connection": "给予者 は 接受者 に 物 を あげます／あげました。",
      "explanation": "「あげます」表示把物品给别人。常见语序是给予者作主题，接受者后接「に」，物品后接「を」；也可表达说话人的亲属把东西给第三者。",
      "tip": "「あげます」的主语是给出物品的人，接受者接「に」，物品接「を」；不要把方向倒成“我从别人那里得到”。",
      "examples": [
        {
          "ja": "わたしは友達に本をあげます。",
          "reading": "わたしはともだちにほんをあげます。",
          "zh": "我把书给朋友。",
          "parts": [
            {
              "text": "わたし",
              "label": "给予者"
            },
            {
              "text": "は",
              "label": "提示给予者"
            },
            {
              "text": "友達",
              "label": "接受者"
            },
            {
              "text": "に",
              "label": "标记接受者"
            },
            {
              "text": "本",
              "label": "给予的物品"
            },
            {
              "text": "を",
              "label": "标记物品"
            },
            {
              "text": "あげます。",
              "label": "表示给予"
            }
          ]
        },
        {
          "ja": "母は近所の人に花をあげました。",
          "reading": "はははきんじょのひとにはなをあげました。",
          "zh": "妈妈把花送给了邻居。",
          "parts": [
            {
