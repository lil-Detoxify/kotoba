  "points": [
    {
      "id": "l2-demonstratives",
      "title": "これ／それ／あれ：单独指物",
      "meaning": "直接指向某件物品，用指示词代替物品名称。",
      "connection": "これ／それ／あれ + は + 名词 + です。",
      "explanation": "说话人与听话人面对面时，说话人手边用「これ」，听话人手边用「それ」，两人都远用「あれ」。两人站在一起并朝同一方向时，则以两人共同的位置比较距离：近处用「これ」，更远处用「それ」，最远处用「あれ」。",
      "tip": "先看两人怎么站。面对面时，「それ」靠近听话人；两人同侧时，「それ」是比「これ」更远的一处。不要把「それ」固定记成离说话人远。",
      "examples": [
        {
          "ja": "これはみずです。",
          "reading": "これはみずです。",
          "zh": "（说话人与听话人面对面，说话人手边有水。）这是水。",
          "parts": [
            {
              "text": "これ",
              "label": "指说话人近处的物品"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "みず",
              "label": "物品名"
            },
            {
              "text": "です。",
              "label": "礼貌判断"
            }
          ]
        },
        {
          "ja": "それは地図です。",
          "reading": "それはちずです。",
          "zh": "（说话人与听话人面对面，地图在听话人手边。）那是地图。",
          "parts": [
            {
              "text": "それ",
              "label": "指听话人近处的物品"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "地図",
              "label": "物品名"
            },
            {
              "text": "です。",
              "label": "礼貌判断"
            }
          ]
        }
      ]
    },
    {
      "id": "l2-who-what",
      "title": "だれ／何ですか：询问人或物",
      "meaning": "不知道人物是谁，或不知道事物是什么时提问。",
      "connection": "人物 + は + だれですか；事物 + は + 何ですか。",
      "explanation": "问人的姓名或身份用「だれ」，问物品或内容用「何」。日语疑问句在句尾加「か」；即使中文不说“吗”，日语里也要保留。",
      "tip": "看你想知道的是“谁”还是“什么”：对象是人选「だれ」，对象是物或内容选「何」。在「何ですか」里，「何」读「なん」。",
      "examples": [
        {
          "ja": "先生はだれですか。",
          "reading": "せんせいはだれですか。",
          "zh": "老师是谁？",
          "parts": [
