    {
      "id": "l2-kono-sono-ano",
      "title": "この／その／あの + 名词",
      "meaning": "把指示词放在名词前，说明所指物品或人物的位置。",
      "connection": "この／その／あの + 名词 + は + ……",
      "explanation": "「この」「その」「あの」后面必须接名词。位置关系与「これ／それ／あれ」相同：面对面时，这个在说话人附近，那个在听话人附近，更远处用「あの」；两人同侧时也按共同视角由近到远。",
      "tip": "「この本」里有名词「本」，可以直接说；如果想单独说“这个”，就用「これ」。不能把「この」当成独立名词使用。",
      "examples": [
        {
          "ja": "この時計は小林さんのです。",
          "reading": "このとけいはこばやしさんのです。",
          "zh": "（说话人与听话人面对面，手表在说话人近处。）这块手表是小林先生的。",
          "parts": [
            {
              "text": "この",
              "label": "修饰说话人近处的名词"
            },
            {
              "text": "時計",
              "label": "物品名"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "小林さん",
              "label": "所属者"
            },
            {
              "text": "の",
              "label": "省略重复的物品名"
            },
            {
              "text": "です。",
              "label": "礼貌判断"
            }
          ]
        },
        {
          "ja": "あの人は森先生です。",
          "reading": "あのひとはもりせんせいです。",
          "zh": "（说话人与听话人面对面，那个人离两人都远。）那个人是森老师。",
          "parts": [
            {
              "text": "あの",
              "label": "修饰离两人都远的名词"
            },
            {
              "text": "人",
              "label": "人物名词"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "森先生",
              "label": "人物身份"
            },
