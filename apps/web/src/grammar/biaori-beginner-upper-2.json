            {
              "text": "の",
              "label": "连接名词"
            },
            {
              "text": "物",
              "label": "被询问的事物"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "何",
              "label": "询问事物内容"
            },
            {
              "text": "ですか。",
              "label": "礼貌疑问"
