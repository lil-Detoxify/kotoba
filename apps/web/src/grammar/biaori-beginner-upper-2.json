    {
      "id": "l2-possession-no",
      "title": "名词 + の：所属与省略",
      "meaning": "说明物品属于谁；物品名称已说过时，可以省去句尾重复的名称。",
      "connection": "所属者 + の + 物品；已知物品名时可用「所属者のです」。",
      "explanation": "「の」把所属者和物品连起来，前面是所属者，后面是物品。物品名称已经出现、不会弄混时，可以在句尾省去重复的名词，用「所属者のです」。",
      "tip": "在「森さんのペン」里，森先生是所属者，笔是物品；说过物品后才可省略，如「このノートは小野さんのです」。不要把「の」也省掉。",
      "examples": [
        {
          "ja": "これは森さんのペンです。",
          "reading": "これはもりさんのぺんです。",
          "zh": "这是森先生的笔。",
          "parts": [
            {
              "text": "これ",
              "label": "指示物品"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "森さん",
              "label": "所属者"
            },
            {
              "text": "の",
              "label": "连接所属者和物品"
            },
            {
              "text": "ペン",
              "label": "所属物品"
            },
            {
              "text": "です。",
              "label": "礼貌判断"
            }
          ]
        },
        {
          "ja": "このノートは小野さんのです。",
          "reading": "こののーとはおのさんのです。",
          "zh": "这个笔记本是小野先生的。",
          "parts": [
            {
              "text": "この",
              "label": "修饰后面的名词"
            },
            {
              "text": "ノート",
              "label": "已知物品"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "小野さん",
              "label": "所属者"
            },
            {
              "text": "の",
              "label": "代替重复的物品名"
            },
            {
              "text": "です。",
              "label": "礼貌判断"
            }
          ]
        }
      ]
