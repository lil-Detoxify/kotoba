              "label": "询问身份的人"
            },
            {
              "text": "は",
              "label": "提示主题"
            },
            {
              "text": "だれ",
              "label": "询问人物身份"
            },
            {
              "text": "ですか。",
              "label": "礼貌疑问"
            }
          ]
        },
        {
          "ja": "机の上の物は何ですか。",
          "reading": "つくえのうえのものはなんですか。",
          "zh": "桌上的东西是什么？",
          "parts": [
            {
              "text": "机",
              "label": "位置参照物"
            },
            {
              "text": "の",
              "label": "连接名词"
            },
            {
              "text": "上",
              "label": "位置"
