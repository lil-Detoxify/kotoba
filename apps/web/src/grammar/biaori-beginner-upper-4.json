  "points": [
    {
      "id": "l4-existence",
      "title": "あります／います：存在与位置",
      "meaning": "说明某处有什么，或某人、某物在哪里。",
      "connection": "场所 に 物／人 が あります／います。／物／人 は 场所 に あります／います。",
      "explanation": "无生命物品用「あります」，人和动物等有生命的对象用「います」。要说某处有什么，把场所放在「に」前、对象放在「が」前；要说明已知对象在哪里，则用「は」提示对象，再用「に」标出所在位置。询问位置时可说「どこにありますか／いますか」；根据语境询问地点时也可用「どこですか」。",
      "tip": "记住「に」标位置、「が」标新出现的对象；不要把物品和人、动物的存在动词互换。",
      "examples": [
        {
          "ja": "ロビーに椅子があります。",
          "reading": "ろびーにいすがあります。",
          "zh": "大厅里有椅子。",
          "parts": [
            {
              "text": "ロビー",
              "label": "场所"
            },
            {
              "text": "に",
              "label": "标出存在位置"
            },
            {
              "text": "椅子",
              "label": "无生命物品"
            },
            {
              "text": "が",
              "label": "提示新出现的对象"
            },
            {
              "text": "あります。",
              "label": "表示物品存在"
            }
          ]
        },
        {
          "ja": "田中さんは学校にいます。",
          "reading": "たなかさんはがっこうにいます。",
          "zh": "田中先生在学校。",
          "parts": [
            {
              "text": "田中さん",
              "label": "已知的人物"
            },
            {
              "text": "は",
              "label": "提示说明对象"
            },
            {
              "text": "学校",
              "label": "所在场所"
            },
            {
              "text": "に",
              "label": "标出位置"
            },
            {
              "text": "います。",
              "label": "表示人物在场"
            }
          ]
        }
      ]
    },
