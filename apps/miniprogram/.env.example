# ==============================================================================
# KotoBud WeChat Mini Program Environment Configuration Template
# DO NOT commit real AppSecret, private keys or tokens to Git.
# ==============================================================================

# WeChat Mini Program AppID (Optional; defaults to touristappid for development)
VITE_WX_APPID=

# Remote KotoBud Backend API base URL (Cloudflare; do not point at COS)
VITE_API_BASE_URL=https://kotobud.com

# Textbook JSON origin. Add this exact host to the WeChat request-domain
# allowlist before testing on a device. Leave unset to use the same default.
VITE_MINIPROGRAM_TEXTBOOK_ASSET_BASE_URL=https://kotobud-assets-1490543304.cos.ap-beijing.myqcloud.com

# Verified COS audio origin. Add this exact host to the WeChat downloadFile
# allowlist before testing on a device. Leave unset to use the same default.
VITE_MINIPROGRAM_AUDIO_ASSET_BASE_URL=https://kotobud-assets-1490543304.cos.ap-beijing.myqcloud.com
