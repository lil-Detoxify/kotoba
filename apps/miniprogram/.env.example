# ==============================================================================
# KotoBud WeChat Mini Program Environment Configuration Template
# DO NOT commit real AppSecret, private keys or tokens to Git.
# ==============================================================================

# WeChat Mini Program AppID (Optional; defaults to touristappid for development)
VITE_WX_APPID=

# Remote KotoBud Backend API base URL (Cloudflare; do not point at COS)
VITE_API_BASE_URL=https://kotobud.com

# Textbook JSON origin. Set this to the exact public HTTPS COS origin after the
# request domain has been added in the WeChat Mini Program console.
VITE_MINIPROGRAM_TEXTBOOK_ASSET_BASE_URL=https://kotobud.com

# Keep audio on Cloudflare until the textbook-only COS rollout passes a
# mainland-device check. This may later be changed to the verified COS origin.
VITE_MINIPROGRAM_AUDIO_ASSET_BASE_URL=https://kotobud.com
