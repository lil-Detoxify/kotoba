# ==============================================================================
# KotoBud WeChat Mini Program Environment Configuration Template
# DO NOT commit real AppSecret, private keys or tokens to Git.
# ==============================================================================

# WeChat Mini Program AppID (Optional; defaults to touristappid for development)
VITE_WX_APPID=

# Remote KotoBud Backend API base URL (Cloudflare; do not point at COS)
VITE_API_BASE_URL=https://kotobud.com

# Textbook JSON origin. kotobud.com serves /data/books by default. Set COS here
# only when that host is included in the WeChat request-domain allowlist.
VITE_MINIPROGRAM_TEXTBOOK_ASSET_BASE_URL=https://kotobud.com

# kotobud.com serves /audio by default. Set COS only after publishing the audio
# objects there and adding that exact host to the WeChat downloadFile allowlist.
VITE_MINIPROGRAM_AUDIO_ASSET_BASE_URL=https://kotobud.com

# Dictionary shards are loaded on demand; this candidate follows the reviewed Web staging data.
# Set the production origin after its dictionary assets are published and verified.
VITE_MINIPROGRAM_DICTIONARY_ASSET_BASE_URL=https://staging.kotobud.com
